print("Программа расчета индекса массы тела (ИМТ)")

try:
    weight = float(input("Введите ваш вес в килограммах: "))
    height_cm = float(input("Введите ваш рост в сантиметрах: "))

    height_m = height_cm / 100
    imt = weight / (height_m ** 2)
    imt = round(imt, 2)

    print(f"Ваш индекс массы тела (ИМТ): {imt}")
    if imt < 18.5:
        print("Категория: Дефицит массы тела. Рекомендуется консультация со специалистом")
    elif 18.5 <= imt < 25:
        print("Категория: Нормальный вес. Так держать!")
    elif 25 <= imt < 30:
        print("Категория: Избыточная масса тела (предожирение).")
    else:
        print("Категория: Ожирение. Рекомендуется консультация со специалистом.")

except ValueError:
    print("Ошибка! Пожалуйста, вводите только числа.")


